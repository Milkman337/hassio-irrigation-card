{
  "name": "hassio-irrigation-card",
  "version": "1.0.4",
  "description": "A polished Home Assistant Lovelace card and advanced automation blueprint for ESPHome-based sprinkler/irrigation controllers.",
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "esphome",
    "irrigation",
    "sprinkler"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/hassio-irrigation-card.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"*.{js,mjs,json,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "custom-card-helpers": "^1.9.0",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
