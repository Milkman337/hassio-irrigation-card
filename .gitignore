# Secrets - never commit real HA URLs/tokens
.env
.env.*
!.env.example
secrets.yaml

# Node
node_modules/
npm-debug.log*
# The built card bundle IS committed (dist/hassio-irrigation-card.js) so it
# has a stable raw-file URL for manual/no-build installs - see README.
# Only its sourcemap is ignored to keep the repo lean.
dist/*.map
*.tsbuildinfo

# Nix / devenv
.devenv/
.devenv.flake.nix
devenv.local.nix
.direnv/
.pre-commit-config.yaml

# direnv
.envrc.local

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Misc
*.log
.cache/
