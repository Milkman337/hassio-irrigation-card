# direnv + devenv integration.
# On first use: `direnv allow`
# This pulls in the devenv shell defined in devenv.nix (Node/TS toolchain, scripts, git-hooks).
source_up_if_exists

eval "$(devenv direnvrc)"

# Load the devenv shell (see devenv.nix). This is reproducible via flake.nix as well
# (`nix develop`), .envrc just makes it automatic when you `cd` into the repo.
use devenv

# Local-only secrets for testing against a real Home Assistant instance.
# Create .env from .env.example - it is gitignored and never committed.
dotenv_if_exists .env
