# Copy this file to .env (gitignored) and fill in your own values.
# Used only for local development/testing scripts - never commit real values.

# Base URL of your Home Assistant instance, e.g. https://homeassistant.local:8123
HA_URL=

# A Home Assistant Long-Lived Access Token (Profile -> Security -> Long-Lived Access Tokens).
# Treat this like a password. Rotate it if it is ever exposed.
HA_TOKEN=
